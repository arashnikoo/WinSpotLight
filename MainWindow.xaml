<Window x:Class="WinSpotLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinSpotLight"
        Width="740"
        WindowStyle="None"
        Background="#F2FFFFFF"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="Height"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Margin="8,1" Padding="6,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F000000"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#140078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResultTemplate">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="22"
                               Foreground="#8A1A1A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,-2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="16"
                               Foreground="#DE1A1A1A"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12"
                               Foreground="#991A1A1A"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,1,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSubtitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Kind}"
                           FontSize="11"
                           Foreground="#661A1A1A"
                           VerticalAlignment="Center"
                           Margin="14,0,10,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="#26000000"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="20,16,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="21"
                           Foreground="#661A1A1A"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#1A1A1A"
                             CaretBrush="#0078D4"
                             FontSize="25"
                             VerticalContentAlignment="Center"
                             Padding="0,2,0,0"
                             MaxLength="200"
                             TextChanged="SearchBox_OnTextChanged"
                             PreviewKeyDown="SearchBox_OnPreviewKeyDown"/>
                    <TextBlock x:Name="Placeholder"
                               Text="Search apps, files, commands, or type math..."
                               FontSize="25"
                               Foreground="#661A1A1A"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Margin="0,2,0,0"/>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#1A000000" Margin="18,0"/>

            <ListBox x:Name="ResultsList"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource ResultTemplate}"
                     ItemContainerStyle="{StaticResource ResultItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     MaxHeight="400"
                     Margin="0,4,0,10"
                     MouseLeftButtonUp="ResultsList_OnMouseLeftButtonUp"/>

            <TextBlock x:Name="EmptyHint"
                       Grid.Row="3"
                       Text="No results"
                       FontSize="14"
                       Foreground="#661A1A1A"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"
                       Visibility="Collapsed"/>
            </Grid>
    </Border>
</Window>
